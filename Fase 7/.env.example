# Copie este arquivo para .env e preencha com suas credenciais.
# O .env real NAO deve ser commitado (ja esta no .gitignore).

# Regiao AWS onde o topico SNS foi criado
AWS_REGION=us-east-1

# ARN do topico SNS criado no console da AWS.
# Exemplo: arn:aws:sns:us-east-1:123456789012:farmtech-alertas
SNS_TOPIC_ARN=

# Credenciais IAM com permissao sns:Publish.
# Alternativa: configure via AWS CLI (aws configure) ou IAM Role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
